# Postgres (defaults shown)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=atrium
PGUSER=atrium
PGPASSWORD=atrium

# Agent runtime
ATRIUM_TICK_MS=400
ATRIUM_WORKSPACE=../workspace

# Engineering room: set both for real github.com pull requests.
# Unset, the branch is still really pushed — to the local bare remote — and the
# tool result says mode:"local". It never claims a PR that does not exist.
# ATRIUM_GH_REPO=owner/name
# GH_TOKEN=ghp_...

# Agent reasoning driver: "scripted" (default) or "llm" (needs ANTHROPIC_API_KEY)
AGENT_DRIVER=scripted
